# ---------------------------------------------------------------- TAK server
COT_URL=ssl://takserver:8089
PYTAK_TLS_CLIENT_CERT=/data/cert.pem
PYTAK_TLS_CLIENT_KEY=/data/key.pem
PYTAK_TLS_DONT_VERIFY=1
#TAK_PROTO=0

# ---------------------------------------------------------------- FMI
# How far back strikes are shown (s, min 120). Colours change at 5, 15, 30
# and 45 minutes.
#HISTORY=1800
# Optional area: west,south,east,north
#FMI_BBOX=18,59,33,71
#TIMEZONE=Europe/Helsinki

# ---------------------------------------------------------------- Output
# Seconds between FMI reads (min 10); new strikes are sent at once
#FETCH_INTERVAL=10
# Seconds between re-sends of all strikes (min 30, old name UPDATE_INTERVAL)
#SEND_STATIC_INTERVAL=60
# Marker lifetime in ATAK (s); always at least 3 send intervals
#STALE_SECONDS=600
#SOURCE_LINE=Source: Finnish Meteorological Institute open data, CC BY 4.0
#DEBUG=0
